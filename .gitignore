# Blender binary files (>100MB blocked by GitHub)
*.blend
*.blend1
*.blend2
*.blend@
*.blend_bak*
*.blend.bak*
*.bak*
*.bak_*

# Allow lightweight tracked assets (<10MB)
!assets/*.blend

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Temporary & system files
.DS_Store
Thumbs.db
*.tmp
temp_*
bug.png

# Archives
*.zip
*.tar.gz
*.7z

# Reference photos upload folders
realne fotky/
realene foto/

# One-off scratch scripts
scratch/
!scratch/build_final_scala.py
!scratch/create_alfa_backup.py
