    </style>




    <script async type="text/javascript" src="/public/js/pop_up.js?v=17848f07d6fc3bbca8cce5a711c42bd8579149d3
"></script>


    <script type="text/javascript">
        $(document).on("click", ".social-right-side-text", async function(e) {
            e.preventDefault();

            const $btn = $(this);
            const $form = $("form#subsForm:visible, form.extra-newsletter-form:visible").first();
            const $extraForm = $(".extra-newsletter-form");
            const siteKey = "6LeuYEYrAAAAAJ8hR1Owa8YaNKrwCkjWuQ6uOg-2";
            const action = "newsletter_signup";

    
            const firstName = ($form.find("[name='cm-fname']").val() || "").trim();
            const lastName = ($form.find("[name='cm-lname']").val() || "").trim();
            const email = ($form.find("[name='cm-email']").val() || "").trim();
            const country = ($form.find("[name='cm-fo-yhijhil']").val() || "").trim();

           

           
            if (!firstName || !lastName || !email || !country) {
                pop_up({
                    type: 'error',
                    title: false,
                    buttons: {cancel: false, order: false},
                    content: 'Please fill in all required fields.'
                });
                return;
            }

            const nameRegex = /^[\p{L} .'-]+$/u;

        if (firstName.length < 2 || !nameRegex.test(firstName)) {
            pop_up({
                type: 'error',
                title: false,
                buttons:
                {cancel: false, order: false},
                // content: 'Please enter a valid first name.'
                content: 'Please enter a valid first name.'
            });
            return;
        }
        if (lastName.length < 2 || !nameRegex.test(lastName)) {
            pop_up({
                type: 'error',
                title: false,
                buttons:
                {cancel: false, order: false},
              
                content: 'Please enter a valid last name.'
            });
            return;
        }

       
        const emailRegex = /^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$/;
        if (!emailRegex.test(email)) {
            pop_up({
                type: 'error',
                title: false,
                buttons: {cancel: false, order: false},
              
                content:
                'Please enter a valid email address.'
            });
            return;
        }


        $btn.css("pointer-events", "none");

        try {
            const token = await grecaptcha.enterprise.execute(siteKey, { action });
            $form.find(".g-recaptcha").val(token);

            $.ajax({
                url: $form.attr("action"),
                method: "POST",
                data: $form.serialize(),
                success: function(response) {
                    console.log("Success:", response);

                    pop_up({
                        type: 'success',
                        title: false,
                        buttons: {cancel: false, order: false},
                        content:
                        'Thank you for signing up!<br />You’ve been added to our mailing list.'
                    });



                    $form.trigger("reset");
                 
                     $(".social-right-side-text")
                     .removeClass("btn-active")
                    //.addClass("disabled")
                     .css("pointer-events", "none");
                },
                error: function(xhr) {
                    console.error("Error:", xhr.responseText);
                },
                complete: function() {
                    $btn.css("pointer-events", "auto");
                }
            });
        } catch (err) {
            console.error("reCAPTCHA error:", err);
            $btn.css("pointer-events", "auto");
        }
    });

    
    $(document).on("input change",
        "form#subsForm input, form#subsForm select, form.extra-newsletter-form input, form.extra-newsletter-form select",
        function() {
            const $form = $("form#subsForm:visible, form.extra-newsletter-form:visible").first();

            const firstName = ($form.find("[name='cm-fname']").val() || "").trim();
            const lastName = ($form.find("[name='cm-lname']").val() || "").trim();
            const email = ($form.find("[name='cm-email']").val() || "").trim();
            const country = ($form.find("[name='cm-fo-yhijhil']").val() || "").trim();

          

            if (firstName && lastName && email && country) {
                $(".social-right-side-text").removeClass("disabled").addClass("btn-active").css("pointer-events",
                    "auto");
                
            } else {
                $(".social-right-side-text").removeClass("btn-active").addClass("disabled").css("pointer-events",
                    "none");
               
                }
            });
    </script>






