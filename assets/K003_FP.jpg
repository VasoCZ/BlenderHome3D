    <script>
        

            $('.account-header').on('click', function() {
                $("#profile-header-menu").toggle();
            });

            $('search-bar-widget form').data('get_results', function() {
                var search_value = $(this).val(),
                    search_key = encodeURIComponent(search_value);

                if (search_value.length > 1) {
                    if (!xhr_cache['search_results_' + search_key]) {
                        if (search_xhr && search_xhr.readyState != 4) {
                            search_xhr.abort();
                        }

                        $("#search-spinner-div").show();

                        search_xhr = $.ajax({
                            url: '/en/ajax/search/auto_suggest',
                            data: {q: search_key},
                            dataType: 'json',
                            cache: false,
                        }).done(function(json) {
                            if (json.html) {
                                xhr_cache['search_results_' + search_key] = json.html;
                                apply_auto_suggest_content(xhr_cache['search_results_' + search_key]);
                            } else {

                                $('.search_results, .show_all_search_results').hide();
                                $('.search_results > div > ul').html('<li><!-- o|||| -->dsadsad</li>');
                            }
                        });
                    } else {
                        apply_auto_suggest_content(xhr_cache['search_results_' + search_key]);
                    }

                }
                $("#search-spinner-div").hide();
            });

        
</script>        <div id="content" class="container">
            
