<script>

      $(function() {
        let menuIds = [];
        $('.mega-submenu-button').each(function() {
            let menuId = $(this).data('menu-id');
            menuIds.push(menuId);
    
            let wrapperSelector = '.' + menuId + '-wrapper, #' + menuId + '-menu';
            let menuSelector = '.' + menuId + '-sub-menu';
            let hasLogos = $(menuSelector).find('.menu-group-logos').length > 0;
    
            let hasSubItems = $(menuSelector).find('.sub-items-container').children().length > 0;
    
            if (!hasSubItems) {
                $(this).removeClass('can-show-arrow');
            }
    
            let height = hasSubItems ? ($(menuSelector + ' div').height() + (hasLogos ? 210 : 110)) : 0;
    
            handleHover(wrapperSelector, menuSelector, height, menuIds, hasSubItems);
        });
    });
    
    function handleHover(wrapperSelector, menuSelector, height, menuIds, hasSubItems) {
        $(wrapperSelector).on("mouseenter", function () {
            let selectors = menuIds.map(id => '.' + id + '-sub-menu').join(', ');
            $(selectors).removeClass("hover");
    
            if (hasSubItems) {
                $(menuSelector).addClass("hover");
                $(".mega-submenu").css("height", height);
            } else {
                $(".mega-submenu").css("height", ""); 
            }
        });
    }
</script>         

